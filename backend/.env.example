# ── App ──────────────────────────────────────────────
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://bcl:bcl@localhost:5432/bcl

# ── Auth / Sessions ───────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=86400
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
AUTH_DOMAIN=localhost:3000
AUTH_URI=http://localhost:3000
BOOTSTRAP_ADMIN_WALLETS=0xYOUR_WALLET_HERE

# ── Chain (Celo Alfajores defaults) ───────────────────
CHAIN_ID=44787
RPC_URL=https://alfajores-forno.celo-testnet.org
EXPLORER_URL=https://alfajores.celoscan.io

# ── Contracts (fill after deployment) ─────────────────
REWARDS_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REGISTRY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# BCL ERC-20 utility token — used to pay for name registrations
BCL_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# BCLNameNFT — ERC-721 ENS-style name registry (paid in BCL)
NAME_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Indexer ───────────────────────────────────────────
REQUIRED_CONFIRMATIONS=3
INDEXER_START_BLOCK=0
INDEXER_BATCH_SIZE=2000
INDEXER_POLL_SECONDS=6
RECONCILE_EVERY_SECONDS=600

# ── Mint worker ───────────────────────────────────────
RELAYER_PRIVATE_KEY=0x...
# "whitelist"  = relayer whitelists; user's wallet calls claim() (platform pays no mint gas)
# "admin_mint" = relayer mints directly (platform pays gas, instant delivery)
MINT_STRATEGY=whitelist
MINT_POLL_SECONDS=5
MINT_MAX_RETRIES=5
MINT_PENDING_TIMEOUT_SECONDS=900
