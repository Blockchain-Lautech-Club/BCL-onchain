# Deployment (see script/Deploy.s.sol)
RPC_URL=
ADMIN_ADDRESS=0x...          # multisig recommended; receives DEFAULT_ADMIN_ROLE
RELAYER_ADDRESS=0x...        # backend relayer; receives MINTER_ROLE on the NFT
NFT_BASE_URI=ipfs://<cid>/   # must end with "/"; token URI = base + level + ".json"
NFT_TRANSFERABLE=false       # false = soulbound
ADMIN_TRANSFER_DELAY=259200  # seconds (3 days) for two-step admin handover
DOMAIN_PRICE_PER_YEAR_WEI=0
DOMAIN_TRANSFERS_ENABLED=true
ETHERSCAN_API_KEY=
